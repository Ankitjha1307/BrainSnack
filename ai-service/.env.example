# AI Provider: mock (local question bank) or gemini
# Leave AI_PROVIDER=mock to run fully offline - no API key needed.
AI_PROVIDER=mock

# Only required when AI_PROVIDER=gemini. Without it the service falls back to
# the local question bank automatically.
GEMINI_API_KEY=

PORT=8000

# The Node API is the only expected caller (server-side, no Origin header).
CORS_ORIGINS=http://localhost:3000
