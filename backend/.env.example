# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brainsnack

# JWT - generate a unique one for any shared/deployed environment
JWT_SECRET=brainsnack-dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
